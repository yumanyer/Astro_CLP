---
const partners = [
  { name: 'ALEPH', img: 'ALEPH.webp' },
  { name: 'Arbitrum', img: 'Arbitrum.webp' },
  { name: 'Avalanche', img: 'avalanche_Red.webp' },
  { name: 'Binance', img: 'Binance_logo.webp' },
  { name: 'Bitget', img: 'bitget_wallet.webp' },
  { name: 'BitPoint', img: 'BitPoint.webp' },
  { name: 'Devconnect', img: 'Devconnect.webp' },
  { name: 'Indo', img: 'indo.webp' },
  { name: 'KAST', img: 'KAST.webp' },
  { name: 'Labitconf', img: 'Labitconf.webp' },
  { name: 'MetaPool', img: 'Meta-Pool-Wordmark-Lime.webp' },
  { name: 'OKX', img: 'okx.webp' },
  { name: 'Team1', img: 'Team1_Text_Main.webp' },
  { name: 'Uniswap', img: 'Uniswap_icon_pink.webp' },
];

// Duplicado una sola vez, en una única fuente de verdad.
// Restricción de simetría: si en el futuro se filtra `partners` por breakpoint,
// filtrar ESTE array antes de duplicarlo — nunca mapear cada mitad por separado.
// Si eso rompe la paridad de ambas mitades, el -50% del CSS deja de ser exacto;
// en ese caso migrar a un marquee JS con una sola copia + duplicación en el seam.
const displayPartners = [...partners, ...partners];
---

<section class="apoyan" id="apoyan">
  <div class="apoyan-block">
    <div class="section-head reveal">
      <h2>Nos Apoyan</h2>
      <p class="section-sub">Sponsors actuales</p>
    </div>

    <div class="marquee reveal">
      <div class="marquee-track">
        {displayPartners.map((partner) => (
          <span class="logo-pill">
            <img 
              src={`img/partners/${partner.img}`} 
              alt={partner.name} 
              style="width: 100px;"
              loading="lazy" 
            />
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.apoyan {
  padding: 60px 0 100px;
  --gap: 24px;
}

.apoyan-block { margin-bottom: 50px; }
.apoyan-block:last-child { margin-bottom: 0; }

.apoyan-block .section-head {
  text-align: left;
  margin-bottom: 28px;
}

.apoyan-block .section-head h2 {
  margin-bottom: 6px;
}

.section-sub {
  font-size: 0.8rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--text-muted);
  font-weight: 500;
}

.marquee {
  overflow: hidden;
  margin-bottom: 0;
  mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
}

.marquee-track {
  display: flex;
  width: max-content;
  align-items: center;
  animation: scrollRight 35s linear infinite;
}

@keyframes scrollRight {
  from { transform: translateX(-50%); }
  to { transform: translateX(0); }
}

.logo-pill {
  margin-right: var(--gap);
  padding: 16px 32px;
  border-radius: 12px;
  background: transparent;
  color: var(--text-muted);
  font-size: 0.85rem;
  white-space: nowrap;
  transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
}
</style>