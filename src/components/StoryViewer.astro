---
// src/components/StoryViewer.astro
---

<div id="storyOverlay" class="hidden">
  <div class="story-backdrop"></div>
  
  <div class="story-modal">
    <div class="story-bars" id="storyBars"></div>
    
    <button class="story-close" id="closeStory" aria-label="Cerrar">✕</button>
    
    <div class="story-media" id="storyMediaContainer"></div>
    
    <div class="story-caption" id="storyCaption"></div>
    
    <div class="story-nav">
      <button class="story-prev" id="prevStory" aria-label="Anterior"></button>
      <button class="story-next" id="nextStory" aria-label="Siguiente"></button>
    </div>
  </div>
</div>

<script>
  interface Story {
    type: 'img' | 'video';
    src: string;
    title?: string;
  }

  // Estado global del story viewer
const storyState = {
  index: 0,
  media: [] as Story[],
  title: '',
  timer: null as number | null,
  DURATION: 4000,
  paused: false,
};
  const overlay = document.getElementById('storyOverlay');
  const barsContainer = document.getElementById('storyBars');
  const mediaContainer = document.getElementById('storyMediaContainer');
  const caption = document.getElementById('storyCaption');
  const closeBtn = document.getElementById('closeStory');
  const prevBtn = document.getElementById('prevStory');
  const nextBtn = document.getElementById('nextStory');
  const modal = overlay?.querySelector('.story-modal');

  function closeStory() {
    if (storyState.timer) clearTimeout(storyState.timer);
    if (overlay) overlay.classList.add('hidden');
    document.body.style.overflow = '';
  }

  function goStory(direction: number) {
    const total = storyState.media.length;
    const next = storyState.index + direction;

    if (next < 0 || next >= total) {
      closeStory();
      return;
    }

    storyState.index = next;
    renderSlide();
  }

  function pauseStory() {
    storyState.paused = true;
    if (storyState.timer) clearTimeout(storyState.timer);

    const activeFill = barsContainer?.querySelector('.story-bar-fill.active');
    if (activeFill) (activeFill as HTMLElement).style.animationPlayState = 'paused';
  }

  function resumeStory() {
    if (!storyState.paused) return;
    storyState.paused = false;

    const activeFill = barsContainer?.querySelector('.story-bar-fill.active');
    if (activeFill) (activeFill as HTMLElement).style.animationPlayState = 'running';

    storyState.timer = window.setTimeout(() => goStory(+1), storyState.DURATION);
  }

  function renderSlide() {
    const { index, media, title, DURATION } = storyState;
    const item = media[index];

    if (!item) return;

    // Actualizar barras de progreso
    const fills = barsContainer?.querySelectorAll('.story-bar-fill');
    if (fills && fills.length > 0) {
      fills.forEach((fill, i) => {
        fill.classList.remove('active', 'done');
        if (i < index) fill.classList.add('done');
        if (i === index) fill.classList.add('active');
        (fill as HTMLElement).style.animation = 'none';
        (fill as HTMLElement).offsetHeight; // reflow
        (fill as HTMLElement).style.animation = '';
      });
    }

    // Renderizar media
    if (mediaContainer) {
      mediaContainer.innerHTML = '';
      if (item.type === 'img') {
        const img = document.createElement('img');
        img.src = item.src;
        img.alt = title || 'Historia';
        img.draggable = false;
        mediaContainer.appendChild(img);
      } else if (item.type === 'video') {
        const video = document.createElement('video');
        video.src = item.src;
        video.autoplay = true;
        video.muted = true;
        video.playsInline = true;
        video.addEventListener('ended', () => goStory(+1));
        mediaContainer.appendChild(video);
      }
    }

    if (caption) caption.textContent = title || '';

    if (storyState.timer) clearTimeout(storyState.timer);
    if (!storyState.paused) {
      storyState.timer = window.setTimeout(() => goStory(+1), DURATION);
    }
  }

  function initStoryBars(mediaArr: Story[]) {
    if (!barsContainer) return;
    barsContainer.innerHTML = '';
    
    mediaArr.forEach(() => {
      const bar = document.createElement('div');
      bar.className = 'story-bar';
      const fill = document.createElement('div');
      fill.className = 'story-bar-fill';
      bar.appendChild(fill);
      barsContainer.appendChild(bar);
    });
  }

  closeBtn?.addEventListener('click', closeStory);
  prevBtn?.addEventListener('click', () => goStory(-1));
  nextBtn?.addEventListener('click', () => goStory(+1));
  
  overlay?.querySelector('.story-backdrop')?.addEventListener('click', closeStory);

  // Pausar al hacer click en el modal
  modal?.addEventListener('pointerdown', pauseStory);
  modal?.addEventListener('pointerup', resumeStory);
  modal?.addEventListener('pointerleave', resumeStory);

  // Soporte de teclado
  document.addEventListener('keydown', (e) => {
    if (!overlay || overlay.classList.contains('hidden')) return;
    if (e.key === 'ArrowRight') goStory(+1);
    if (e.key === 'ArrowLeft') goStory(-1);
    if (e.key === 'Escape') closeStory();
  });

  window.addEventListener('open-stories', (e: Event) => {
    const customEvent = e as CustomEvent<{ stories: Story[], startIndex?: number, title?: string }>;
    const { stories, startIndex = 0, title = '' } = customEvent.detail;
    
    storyState.index = startIndex;
    storyState.media = stories;
    storyState.title = title;
    storyState.paused = false;
    
    if (storyState.timer) clearTimeout(storyState.timer);
    
    initStoryBars(stories);
    
    if (overlay) {
      overlay.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      renderSlide();
    }
  });
</script>

<style>
  /* ============ STORY VIEWER (overlay) ============ */
  #storyOverlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #storyOverlay.hidden {
    display: none;
  }

  .story-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
  }

  .story-modal {
    position: relative;
    width: min(420px, 96vw);
    aspect-ratio: 9/16;
    border-radius: 20px;
    overflow: hidden;
    background: #111;
    box-shadow: 0 0 60px rgba(0, 0, 0, 0.6);
  }

  /* Barras de progreso */
  .story-bars {
    position: absolute;
    top: 14px;
    left: 12px;
    right: 12px;
    display: flex;
    gap: 4px;
    z-index: 10;
  }

  .story-bar {
    flex: 1;
    height: 3px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.3);
    overflow: hidden;
  }

  .story-bar-fill {
    height: 100%;
    width: 0%;
    background: var(--white);
  }

  .story-bar-fill.done {
    width: 100%;
  }

  .story-bar-fill.active {
    animation: storyProgress 4s linear forwards;
  }

  @keyframes storyProgress {
    from {
      width: 0%;
    }
    to {
      width: 100%;
    }
  }

  /* Botón cerrar */
  .story-close {
    position: absolute;
    top: 36px;
    right: 14px;
    z-index: 10;
    background: rgba(0, 0, 0, 0.35);
    border: none;
    color: var(--white);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: 0.85rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }

  .story-close:hover {
    background: rgba(0, 0, 0, 0.5);
  }

  /* Imagen/video */
  .story-media {
    width: 100%;
    height: 100%;
    cursor: pointer;
  }

  .story-media img,
  .story-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Caption */
  .story-caption {
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 1rem;
    color: var(--white);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
    padding: 0 20px;
    z-index: 10;
  }

  /* Botones nav invisibles izq/der */
  .story-nav {
    position: absolute;
    inset: 0;
    display: flex;
    z-index: 5;
    pointer-events: none;
  }

  .story-prev,
  .story-next {
    flex: 1;
    background: none;
    border: none;
    cursor: pointer;
    pointer-events: all;
  }
</style>