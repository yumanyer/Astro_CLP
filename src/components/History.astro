const years = Object.keys(orbitalData);
---

<section class="historia" id="historia">
  <div class="section-head reveal">
    <h2>Nuestra Historia</h2>
    <p>Desde 2017 construyendo comunidad, eventos y conocimiento Web3 en La Plata.</p>
  </div>

  <div class="orbital-wrap reveal">
    <div class="orbital-container" id="orbital">
      <img src="/img/icon/CLP-premium.webp" class="orbital-logo" width="180" height="180" alt="CLP" decoding="async">      
      <div class="orbital-ring">
        {years.map((year, index) => {
          const angle = (index * (360 / years.length)) + 198;
          return (
            <OrbitalItem 
              year={year} 
              angle={angle} 
              active={year === '2017'} 
            />
          )
        })}
      </div>
    </div>

    <div class="orbital-info" id="orbitalInfo">
      <span class="info-year" id="infoYear">2017</span>
      <h3 id="infoTitle">Primeros encuentros</h3>
      <p id="infoText">Nace la comunidad con meetups informales sobre blockchain.</p>
      <div class="info-media" id="infoMedia">
        <!-- Las imágenes aquí se renderizarán dinámicamente -->
      </div>
    </div>
  </div>

  <!-- Componente StoryViewer (Modal oculto) -->
  <StoryViewer />
</section>

<script define:vars={{ orbitalData }}>
  const orbitalInfo = document.getElementById('orbitalInfo');
  const infoYear = document.getElementById('infoYear');
  const infoTitle = document.getElementById('infoTitle');
  const infoText = document.getElementById('infoText');
  const infoMedia = document.getElementById('infoMedia');
  const items = document.querySelectorAll('.orbital-item');

  function renderMedia(mediaArr, title) {
    if (!infoMedia) return;
    infoMedia.innerHTML = '';
    if (!mediaArr.length) return;

    const thumbsWrap = document.createElement('div');
    thumbsWrap.className = 'story-thumbs';

    mediaArr.forEach((m, i) => {
      const thumb = document.createElement('button');
      thumb.className = 'story-thumb';
      thumb.setAttribute('aria-label', `Ver foto ${i + 1}`);

      if (m.type === 'img') {
        const img = document.createElement('img');
        img.src = m.src;
        img.alt = '';
        thumb.appendChild(img);
      } else {
        thumb.innerHTML = `<span class="thumb-video-icon">▶</span>`;
      }

      const ring = document.createElement('div');
      ring.className = 'story-thumb-ring';
      thumb.appendChild(ring);
      
      thumb.addEventListener('click', () => openStory(mediaArr, title));
      thumbsWrap.appendChild(thumb);
    });

    const VISIBLE = 5;
    const hidden = mediaArr.length - VISIBLE;
    if (hidden > 0) {
      const extra = document.createElement('button');
      extra.className = 'story-thumb story-thumb-more';
      extra.textContent = `+${hidden}`;
      extra.addEventListener('click', () => openStory(mediaArr, title));
      Array.from(thumbsWrap.children).forEach((el, i) => {
        if (i >= VISIBLE) el.style.display = 'none';
      });
      thumbsWrap.appendChild(extra);
    }

    infoMedia.appendChild(thumbsWrap);
  }

  function openStory(mediaArr, title) {
    if (!mediaArr || mediaArr.length === 0) return;
    const event = new CustomEvent('open-stories', {
      detail: {
        stories: mediaArr,
        startIndex: 0,
        title: title
      }
    });
    window.dispatchEvent(event);
  }

  function updateInfoPanel(year) {
    const data = orbitalData[year];
    
    orbitalInfo.classList.remove('fade');
    void orbitalInfo.offsetWidth; // trigger reflow
    orbitalInfo.classList.add('fade');

    infoYear.textContent = year === 'actualidad' ? 'Hoy' : year;
    infoTitle.textContent = data.title;
    infoText.textContent = data.text;
    
    renderMedia(data.media, data.title);
  }

  items.forEach(item => {
    item.addEventListener('click', () => {
      const year = item.getAttribute('data-year');
      items.forEach(i => i.classList.remove('active'));
      item.classList.add('active');
      updateInfoPanel(year);
    });
  });

  // Inicializar el primer año
  updateInfoPanel("2017");
</script>

<style is:global>
  .orbital-container {
    --size: clamp(380px, 45vw, 560px);
    --radius: calc(var(--size) / 2 - 50px);
    --orbit-duration: 90s;
  }
/* Story Thumbs */
  .story-thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
  }

  .story-thumb {
    position: relative;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    overflow: hidden;
    border: none;
    padding: 3px;
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    cursor: pointer;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .story-thumb:hover {
    transform: scale(1.08);
  }

  .story-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid var(--bg);
    display: block;
  }

  .story-thumb-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid transparent;
    pointer-events: none;
  }

  .story-thumb-more {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border) !important;
    color: var(--white);
    font-family: var(--font-title);
    font-size: 0.85rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .story-thumb-more:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .thumb-video-icon {
    color: var(--primary);
    font-size: 1.2rem;
  }

  .orbital-info.fade {
    animation: fadeInfo 0.3s ease;
  }

  @keyframes fadeInfo {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 900px) {
    .orbital-wrap {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }


  /* ============ STORY VIEWER (overlay) ============ */
#storyOverlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.story-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.85);
  backdrop-filter: blur(12px);
}

.story-modal {
  position: relative;
  width: min(420px, 96vw);
  aspect-ratio: 9/16;
  border-radius: 20px;
  overflow: hidden;
  background: #111;
  box-shadow: 0 0 60px rgba(0,0,0,0.6);
}

/* Barras de progreso */
.story-bars {
  position: absolute;
  top: 14px;
  left: 12px;
  right: 12px;
  display: flex;
  gap: 4px;
  z-index: 10;
}
.story-bar {
  flex: 1;
  height: 3px;
  border-radius: 99px;
  background: rgba(255,255,255,0.3);
  overflow: hidden;
}
.story-bar-fill {
  height: 100%;
  width: 0%;
  background: var(--white);
}
.story-bar-fill.done {
  width: 100%;
}
.story-bar-fill.active {
  animation: storyProgress 4s linear forwards;
}
@keyframes storyProgress {
  from { width: 0%; }
  to   { width: 100%; }
}

/* Botón cerrar */
.story-close {
  position: absolute;
  top: 36px;
  right: 14px;
  z-index: 10;
  background: rgba(0,0,0,0.35);
  border: none;
  color: var(--white);
  width: 32px;
  height: 32px;
  border-radius: 50%;
  font-size: 0.85rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Imagen/video */
.story-media {
  width: 100%;
  height: 100%;
  cursor: pointer;
}
.story-media img,
.story-media video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Caption */
.story-caption {
  position: absolute;
  bottom: 24px;
  left: 0; right: 0;
  text-align: center;
  font-family: var(--font-title);
  font-weight: 700;
  font-size: 1rem;
  color: var(--white);
  text-shadow: 0 2px 12px rgba(0,0,0,0.7);
  padding: 0 20px;
  z-index: 10;
}

/* Botones nav invisibles izq/der */
.story-nav {
  position: absolute;
  inset: 0;
  display: flex;
  z-index: 5;
  pointer-events: none;
}
.story-prev, .story-next {
  flex: 1;
  background: none;
  border: none;
  cursor: pointer;
  pointer-events: all;
}
</style>

<style>
  .historia { padding: 100px 0; position: relative; }

  .orbital-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    margin: 0 auto;
    padding: 0 32px;
  }

  .orbital-container {
    position: relative;
    width: var(--size);
    height: var(--size);
    margin: 0 auto;
    border-radius: 50%;
    border: 1px dashed var(--glass-border);
  }

  .orbital-logo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 90px;
    height: 90px;
    object-fit: contain;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    filter: drop-shadow(0 0 24px rgba(4,255,183,0.25));
    z-index: 2;
  }

  .orbital-ring {
    position: absolute;
    inset: 0;
    animation: orbitSpin var(--orbit-duration) linear infinite;
  }

  .orbital-container:hover .orbital-ring,
  .orbital-container:hover .orbital-item .orbital-year {
    animation-play-state: paused;
  }

  @keyframes orbitSpin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  .orbital-info {
    padding: 32px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(8px);
    min-height: 280px;
  }

  .info-year {
    display: inline-block;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 1.4rem;
    margin-bottom: 12px;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .orbital-info h3 { font-size: 1.2rem; margin-bottom: 12px; }
  .orbital-info p { font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; }

  .info-media {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

 
</style>