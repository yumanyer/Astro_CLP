---
import OrbitalItem from './OrbitalItem.astro';
// Datos de la historia — 1 foto + 3 hitos por año (portado de prototipo-historia).
// `photo`: 1 foto por año. Para 2017-2023 hoy son placeholders (2024_1.webp).
// `hitos`: 3 hitos de texto por año.
const HISTORIA = [
  {
    key: '2017',
    label: '2017',
    title: 'Primeros encuentros',
    text: 'Nace la comunidad con meetups informales sobre blockchain.',
    photo: 'img/year/2017.webp',
    hitos: [
      'Primeros meetups informales sobre blockchain',
      'Se forma el grupo inicial de entusiastas',
      'Nace la idea de una comunidad web3 en La Plata',
    ],
  },
  {
    key: '2018',
    label: '2018',
    title: 'Primeros talleres',
    text: 'Charlas introductorias a Bitcoin y Ethereum en espacios universitarios.',
    photo: 'img/year/2018.webp',
    hitos: [
      'Talleres introductorios de Bitcoin y Ethereum',
      'Charlas en espacios universitarios de La Plata',
      'Primeros asistentes recurrentes y referentes locales',
    ],
  },
  {
    key: '2019',
    label: '2019',
    title: 'Alianzas locales',
    text: 'Primeras colaboraciones con espacios de coworking y hubs tech.',
    photo: 'img/year/2019.webp',
    hitos: [
      'Colaboración con espacios de coworking',
      'Alianzas con hubs tech locales',
      'La comunidad crece más allá del grupo inicial',
    ],
  },
  {
    key: '2020',
    label: '2020',
    title: 'Eventos virtuales',
    text: 'La comunidad migra a formatos online, sumando alcance nacional.',
    photo: 'img/year/2020.webp',
    hitos: [
      'Adaptación a eventos 100% virtuales',
      'Nuevo alcance nacional en cada encuentro',
      'Charlas y contenido online para toda la comunidad',
    ],
  },
  {
    key: '2021',
    label: '2021',
    title: 'Boom Web3',
    text: 'Crecimiento acelerado de miembros y primeras meetups masivas presenciales.',
    photo: 'img/year/2021.webp',
    hitos: [
      'Crecimiento acelerado de miembros',
      'Primeras meetups presenciales masivas',
      'La comunidad se consolida como referente local',
    ],
  },
  {
    key: '2022',
    label: '2022',
    title: 'Educación formal',
    text: 'Primeros cursos y programas educativos junto a universidades.',
    photo: 'img/year/2022.webp',
    hitos: [
      'Primeros cursos de blockchain',
      'Programas educativos junto a universidades',
      'Puente entre la academia y el ecosistema web3',
    ],
  },
  {
    key: '2023',
    label: '2023',
    title: 'Red de voluntariado',
    text: 'Se conforma la red de voluntariado tecnológico de la comunidad.',
    photo: 'img/year/2023.webp',
    hitos: [
      'Se conforma la red de voluntariado',
      'Voluntarios tecnológicos para eventos y contenidos',
      'Base organizativa que sostiene a la comunidad',
    ],
  },
  {
    key: '2024',
    label: '2024',
    title: 'Eventos insignia',
    text: 'Consolidación de eventos propios de referencia en la región.',
    photo: 'img/year/2024.webp',
    hitos: [
      'View Parties oficiales (Polkadot Decoded)',
      'Eventos propios de referencia regional',
      'Side events internacionales (ETH Uruguay)',
    ],
  },
  {
    key: '2025',
    label: '2025',
    title: 'Expansión institucional',
    text: 'Nuevas alianzas con organizaciones, sponsors y protocolos.',
    photo: 'img/year/2025.webp',
    hitos: [
      'Meetups camino a Devconnect Argentina',
      'Hackathon junto a Crecimiento',
      'Primeras ediciones de Build Buddies con Meta Pool',
    ],
  },
  {
    key: 'actualidad',
    label: 'Hoy',
    title: 'Hacia el futuro',
    text: 'Seguimos creciendo como referencia Web3 de La Plata.',
    photo: 'img/year/2026.webp',
    hitos: [
      'Hackathones con Avalanche y Aleph',
      'Build Buddies Caffeine Sessions',
      'Nueva landing 2026 y foco total en comunidad',
    ],
  },
];
const years = HISTORIA.map((entry) => entry.key);
---
<section class="historia" id="historia">
  <div class="section-head reveal">
    <h2>Nuestra Historia</h2>
    <p>Desde 2017 construyendo comunidad, eventos y conocimiento Web3 en La Plata.</p>
  </div>
  <div class="orbital-wrap reveal">
    <div class="orbital-container" id="orbital">
      <img src="/img/icon/CLP-premium.webp" class="orbital-logo" width="64" height="64" alt="CLP" decoding="async" loading="lazy">
      <div class="orbital-ring">
        {years.map((year, index) => {
          const angle = (index * (360 / years.length)) + 198;
          return (
            <OrbitalItem
              year={year}
              angle={angle}
              active={year === '2017'}
            />
          )
        })}
      </div>
    </div>
    <div class="orbital-info" id="orbitalInfo">
      <span class="info-year" id="infoYear">2017</span>
      <h3 id="infoTitle">Primeros encuentros</h3>
      <p class="info-text" id="infoText">Nace la comunidad con meetups informales sobre blockchain.</p>
      <div class="info-body">
        <button class="info-photo" id="infoPhoto" aria-label="Ver foto en grande">
          <img id="infoPhotoImg" src="img/year/2024_1.webp" alt="" />
          <span class="info-photo-zoom">＋</span>
        </button>
        <div class="info-hitos">
          <h4 class="info-hitos-title">Hitos del año</h4>
          <ul class="hitos-list" id="hitosList"></ul>
        </div>
      </div>
    </div>
  </div>
  <div class="lightbox" id="lightbox" hidden>
    <div class="lightbox-backdrop" data-close></div>
    <div class="lightbox-content">
      <button class="lightbox-close" data-close aria-label="Cerrar">✕</button>
      <img id="lightboxImg" src="" alt="" />
    </div>
  </div>
</section>
<script define:vars={{ HISTORIA }}>
  // ============ REGISTRO DE RESPALDO PARA @property ============
  // El @property vive en src/styles/orbital-properties.css. Este bloque
  // es un fallback: si por algún motivo el CSS no llegó a registrar
  // --spin/--angle (build, orden de carga, cache de HMR), lo hacemos
  // acá vía JS puro, que es inmune a minificadores de CSS.
  // El try/catch absorbe el caso normal (ya registrada por el CSS).
  if (typeof CSS !== 'undefined' && CSS.registerProperty) {
    try {
      CSS.registerProperty({ name: '--spin', syntax: '<angle>', inherits: true, initialValue: '0deg' });
    } catch (e) {}
    try {
      CSS.registerProperty({ name: '--angle', syntax: '<angle>', inherits: true, initialValue: '0deg' });
    } catch (e) {}
  }

  const orbitalInfo = document.getElementById('orbitalInfo');
  const infoYear = document.getElementById('infoYear');
  const infoTitle = document.getElementById('infoTitle');
  const infoText = document.getElementById('infoText');
  const infoPhotoBtn = document.getElementById('infoPhoto');
  const infoPhotoImg = document.getElementById('infoPhotoImg');
  const hitosList = document.getElementById('hitosList');
  const items = document.querySelectorAll('.orbital-item');
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightboxImg');
  // ============ RENDER DEL PANEL (1 foto + 3 hitos) ============
  function renderYear(key) {
    const entry = HISTORIA.find((e) => e.key === key);
    if (!entry || !orbitalInfo || !infoYear || !infoTitle || !infoText || !infoPhotoImg || !hitosList) return;
    orbitalInfo.classList.remove('fade');
    void orbitalInfo.offsetWidth; // trigger reflow
    orbitalInfo.classList.add('fade');
    infoYear.textContent = entry.label;
    infoTitle.textContent = entry.title;
    infoText.textContent = entry.text;
    infoPhotoImg.src = entry.photo;
    infoPhotoImg.alt = `Foto de ${entry.title} (${entry.label})`;
    hitosList.innerHTML = '';
    entry.hitos.forEach((hito, i) => {
      const li = document.createElement('li');
      const num = document.createElement('span');
      num.className = 'hito-num';
      num.textContent = String(i + 1);
      li.appendChild(num);
      li.appendChild(document.createTextNode(hito));
      hitosList.appendChild(li);
    });
  }
  // ============ INTERACCION ORBITA ============
  items.forEach((item) => {
    item.addEventListener('click', () => {
      const year = item.getAttribute('data-year');
      items.forEach((i) => {
        i.classList.remove('active');
        i.setAttribute('aria-pressed', 'false');
      });
      item.classList.add('active');
      item.setAttribute('aria-pressed', 'true');
      if (year) renderYear(year);
    });
  });
  // ============ LIGHTBOX (foto en grande) ============
  function openLightbox() {
    if (!lightbox || !lightboxImg || !infoPhotoImg) return;
    lightboxImg.src = infoPhotoImg.src;
    lightboxImg.alt = infoPhotoImg.alt;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    if (!lightbox) return;
    lightbox.hidden = true;
    document.body.style.overflow = '';
  }
  infoPhotoBtn?.addEventListener('click', openLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target.hasAttribute('data-close')) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox && !lightbox.hidden) closeLightbox();
  });
  // Inicializar el primer año
  renderYear('2017');
</script>
<style is:global>
  .hitos-list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.45;
  }
  .hito-num {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-title);
    font-size: 0.7rem;
    font-weight: 700;
    background: var(--gradient);
    color: #050505;
  }
</style>
<style>
  .historia { padding: 100px 0; position: relative; }
  @media (max-width: 640px) {
    .historia { padding: 70px 0 80px; }
  }
  .orbital-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    margin: 0 auto;
    padding: 0 32px;
    max-width: 1280px;
  }
  .orbital-container {
    position: relative;
    width: var(--size);
    height: var(--size);
    margin: 0 auto;
    border-radius: 50%;
    border: 1px dashed var(--glass-border);
    /* Recorta el bbox del ring rotado (un cuadrado que al rotar sobresale
       del círculo) SIN recortar los items: su borde externo máximo es
       size/2 - 18px, siempre dentro del círculo de radio size/2. */
    overflow: hidden;
    --size: clamp(380px, 45vw, 560px);
    --radius: calc(var(--size) / 2 - 50px);
    --orbit-duration: 90s;
    /* Única fuente de verdad del giro: se anima --spin acá, y tanto
       .orbital-ring como .orbital-year (en OrbitalItem.astro) leen
       ese mismo valor en cada frame. Ya no hay dos animaciones
       independientes que deban coincidir por timing. */
    animation: spin var(--orbit-duration) linear infinite;
  }
  .orbital-container:hover {
    animation-play-state: paused;
  }
  .orbital-logo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 90px;
    height: 90px;
    object-fit: contain;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    filter: drop-shadow(0 0 24px rgba(4,255,183,0.25));
    z-index: 2;
  }
  .orbital-ring {
    position: absolute;
    inset: 0;
    transform: rotate(var(--spin));
  }
  @keyframes spin {
    to { --spin: 360deg; }
  }
  .orbital-info {
    padding: 32px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(8px);
    min-height: 320px;
  }
  .orbital-info.fade { animation: fadeInfo 0.3s ease; }
  @keyframes fadeInfo {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .info-year {
    display: inline-block;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 1.4rem;
    margin-bottom: 12px;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .orbital-info h3 { font-size: 1.2rem; margin-bottom: 10px; }
  .info-text { font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 24px; }
  /* ============ PANEL: FOTO + HITOS ============ */
  .info-body {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 24px;
    align-items: start;
  }
  .info-photo {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    background: linear-gradient(135deg, rgba(4,255,183,0.12), rgba(213,63,233,0.12));
    padding: 0;
    cursor: zoom-in;
  }
  .info-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .info-photo:hover img { transform: scale(1.05); }
  .info-photo-zoom {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    color: var(--white);
    background: rgba(0, 0, 0, 0.35);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .info-photo:hover .info-photo-zoom,
  .info-photo:focus-visible .info-photo-zoom { opacity: 1; }
  .info-hitos-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin-bottom: 14px;
  }
  .hitos-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
  }
  /* ============ LIGHTBOX ============ */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox[hidden] { display: none; }
  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(12px);
  }
  .lightbox-content {
    position: relative;
    max-width: min(420px, 94vw);
    width: 100%;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 0 60px rgba(0, 0, 0, 0.6);
  }
  .lightbox-content img {
    width: 100%;
    height: auto;
    max-height: 86vh;
    object-fit: contain;
    display: block;
  }
  .lightbox-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.4);
    color: var(--white);
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .lightbox-close:hover { background: rgba(0, 0, 0, 0.65); }
  /* ============ RESPONSIVE ============ */
  @media (max-width: 900px) {
    .orbital-wrap { grid-template-columns: 1fr; gap: 60px; }
  }
  @media (max-width: 640px) {
    .orbital-wrap { gap: 48px; padding: 0 16px; }
    .orbital-container {
      /* Nunca más ancho que el viewport: 88vw < 100vw con margen de 16px por lado */
      --size: min(88vw, 320px);
      --radius: calc(var(--size) / 2 - 38px);
    }
    .orbital-logo { width: 62px; height: 62px; }
    .orbital-info { padding: 24px 20px; min-height: 0; }
    .info-body { grid-template-columns: 1fr; }
    .info-photo { max-width: 220px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .orbital-container { animation: none; }
  }
</style>