---
interface Social {
  platform: string;
  url: string;
}

interface Props {
  name: string;
  role: string;
  description: string;
  image: string;
  socials: Social[];
}

const { name, role, description, image, socials } = Astro.props;
---

<article class="team-card" tabindex="0">
  <img
    class="team-image"
    src={image}
    alt={`Foto de ${name}`}
    loading="lazy"
  />

  <div class="team-overlay">
    <div class="team-info">
      <span class="team-role">{role}</span>

      <h3>{name}</h3>

      <p>{description}</p>

      <div class="team-socials">
        {socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${social.platform} de ${name}`}
          >
            {social.platform}
          </a>
        ))}
      </div>
    </div>
  </div>
</article>

<style>
  .team-card {
    position: relative;
    height: 380px;
    overflow: hidden;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #111;
    cursor: pointer;
    outline: none;
  }

  .team-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .team-overlay {
    position: absolute;
    inset: 0;

    display: flex;
    align-items: flex-end;

    padding: 28px;

    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.95) 0%,
      rgba(0, 0, 0, 0.75) 35%,
      rgba(0, 0, 0, 0.15) 75%,
      rgba(0, 0, 0, 0) 100%
    );

    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .team-info {
    width: 100%;
    transform: translateY(20px);
    transition: transform 0.35s ease;
  }

  .team-role {
    display: block;
    margin-bottom: 6px;

    color: #00f5b3;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .team-info h3 {
    margin: 0 0 10px;

    color: white;
    font-size: 1.45rem;
    font-weight: 700;
  }

  .team-info p {
    margin: 0 0 18px;

    max-width: 420px;

    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .team-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .team-socials a {
    padding: 7px 12px;

    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;

    color: white;
    background: rgba(255, 255, 255, 0.08);

    font-size: 0.8rem;
    text-decoration: none;

    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .team-socials a:hover {
    background: rgba(0, 245, 179, 0.15);
    border-color: #00f5b3;
  }

  /* =========================
     HOVER / FOCUS
  ========================= */

  .team-card:hover .team-overlay,
  .team-card:focus .team-overlay,
  .team-card:focus-within .team-overlay {
    opacity: 1;
  }

  .team-card:hover .team-info,
  .team-card:focus .team-info,
  .team-card:focus-within .team-info {
    transform: translateY(0);
  }

  .team-card:hover .team-image {
    transform: scale(1.04);
  }

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 640px) {
    .team-card {
      height: 340px;
    }

    .team-overlay {
      opacity: 1;
      padding: 22px;
    }

    .team-info {
      transform: translateY(0);
    }
  }
</style>